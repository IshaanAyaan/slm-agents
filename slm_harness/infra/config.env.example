# Copy to research/slm_harness/infra/config.env and edit. config.env is gitignored.
# NO SECRETS are required here. VPN/SSH credentials live OUTSIDE the repo (see RUNBOOK).
#
# Defaults below are sized for an 8x V100-16GB DGX-1 (fp16, no bf16/FlashAttention).
# On H100/A100 you can raise TEACHER_MODEL to a 70B and set VLLM_DTYPE=auto.

# --- Models (open weights, ungated; Qwen2.5 family is the reliable lane on Volta) ---
export TEACHER_MODEL="Qwen/Qwen2.5-14B-Instruct"
export STUDENT_A_MODEL="Qwen/Qwen2.5-3B-Instruct"     # headline specialist
export STUDENT_B_MODEL="Qwen/Qwen2.5-1.5B-Instruct"   # size ablation

# --- Serving ---
export TEACHER_PORT=8001
export STUDENT_PORT=8002
export TEACHER_TP=4             # 14B fp16 over 4x16GB; raise to 8 for more speed
export VLLM_DTYPE=half          # V100: fp16 (bf16 unsupported on sm70)
export MAX_MODEL_LEN=12288
export VLLM_API_KEY="EMPTY"     # local only; not a real secret

# --- Hardware cost (for the self-hosted cost model) ---
export GPU_HOURLY_USD=2.50      # amortized $ per GPU-hour; set YOUR real rate
export NUM_GPUS=""              # blank = auto-detect via nvidia-smi
export TRAIN_GPUS=1             # LoRA training uses this many GPUs (CUDA_VISIBLE_DEVICES)

# --- Benchmark repos (real ground truth, generated on-box). Format: id:path:split ---
# Paths are resolved relative to the repo root if not absolute. 'auto:<module>' uses
# an installed python package's directory.
export BENCH_REPOS="\
openharness:src/openharness:train \
requests:auto:requests:train \
ohmo:ohmo:test"
export TRAIN_MAX_TASKS=250
export TEST_MAX_TASKS=120

# --- Experiment ---
export SEEDS=3                  # seeds per condition per task on eval
export TRAIN_SEEDS=2            # seeds for teacher data-gen on train split
export RUN_ABLATION=1           # 1 = also run the STUDENT_B size ablation
