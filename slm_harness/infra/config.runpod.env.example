# Single-GPU profile matching the published run (one NVIDIA H100 NVL 94GB).
# Copy to slm_harness/infra/config.env on the pod. config.env is gitignored.
#
# Any 80GB+ card works for the 72B-AWQ teacher. On a 48GB card (A40/A6000)
# substitute a 14B teacher and expect a weaker baseline.

# --- Models (open, ungated; AWQ keeps the 72B inside one card) ---
export TEACHER_MODEL="Qwen/Qwen2.5-72B-Instruct-AWQ"  # ~41GB weights, serves C1/C6 + distillation
export STUDENT_A_MODEL="Qwen/Qwen2.5-7B-Instruct"     # size sweep
export STUDENT_B_MODEL="Qwen/Qwen2.5-3B-Instruct"     # headline specialist in the paper
export STUDENT_C_MODEL="Qwen/Qwen2.5-1.5B-Instruct"   # smallest ablation

# --- Serving (single GPU) ---
export TEACHER_PORT=18001
export STUDENT_PORT=18002
export TEACHER_TP=1
export VLLM_DTYPE=""            # empty = auto (bf16 on Ampere+; fp16 for AWQ)
export MAX_MODEL_LEN=12288
export VLLM_API_KEY="EMPTY"

# --- Hardware cost (self-hosted cost model) ---
export GPU_HOURLY_USD=3.19      # set to your pod's actual $/hr. Ratios are rate-independent.
export NUM_GPUS=1
export TRAIN_GPUS=1

# --- Benchmark repos (generated on the pod from installed pip packages) ---
# The published run also used two local corpora that lived in the original
# monorepo. The frozen task runs and SFT data from that run are committed under
# slm_harness/results/real, so fresh runs can use any pip-installable packages.
export BENCH_REPOS="\
requests:auto:requests:train \
urllib3:auto:urllib3:train \
flask:auto:flask:test \
click:auto:click:test \
rich:auto:rich:test \
httpx:auto:httpx:test"
export TRAIN_MAX_TASKS=80
export TEST_MAX_TASKS=40

# --- Experiment (decoding is temperature 0, so extra seeds replay identical
#     trajectories; spend budget on tasks and repos instead) ---
export SEEDS=1
export TRAIN_SEEDS=1
export RUN_ABLATION=1
