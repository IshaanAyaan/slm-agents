{
  "suite_id": "smoke-nav-v1",
  "description": "Local smoke benchmark: 10 file/code navigation tasks over the synthetic 'orderflow' fixture repo. Fast, offline, deterministic environment. Splits: 6 train / 2 val / 2 test (train split feeds the distillation pipeline).",
