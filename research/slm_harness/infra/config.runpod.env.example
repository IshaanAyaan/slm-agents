# Single-GPU profile (RunPod / one Ampere+ card, e.g. RTX A6000 48GB).
# Copy to research/slm_harness/infra/config.env on the pod. config.env is gitignored.
#
# Ampere+ (sm80+) supports bf16 + FlashAttention, so this uses the clean path
# (no V100 workarounds). One model is resident at a time, so 48GB is plenty for a
# 14B teacher and the 3B/1.5B students run sequentially.

# --- Models (open, ungated) ---
export TEACHER_MODEL="Qwen/Qwen2.5-14B-Instruct"      # ~28GB bf16, fits 48GB w/ KV cache
export STUDENT_A_MODEL="Qwen/Qwen2.5-3B-Instruct"     # headline specialist
export STUDENT_B_MODEL="Qwen/Qwen2.5-1.5B-Instruct"   # size ablation

# --- Serving (single GPU) ---
export TEACHER_PORT=8001
export STUDENT_PORT=8002
export TEACHER_TP=1
export VLLM_DTYPE=""            # empty = auto (bf16 on Ampere); run_all sets half on V100
export MAX_MODEL_LEN=12288
export VLLM_API_KEY="EMPTY"

# --- Hardware cost (self-hosted cost model) ---
export GPU_HOURLY_USD=0.49      # set to your pod's actual $/hr (A6000=0.49). Ratios are rate-independent.
export NUM_GPUS=1
export TRAIN_GPUS=1

# --- Benchmark repos (real ground truth, generated on the pod) ---
export BENCH_REPOS="\
openharness:src/openharness:train \
requests:auto:requests:train \
ohmo:ohmo:test"
export TRAIN_MAX_TASKS=200
export TEST_MAX_TASKS=120

# --- Experiment (trim seeds to save budget; raise later for tighter error bars) ---
export SEEDS=3
export TRAIN_SEEDS=2
export RUN_ABLATION=1
