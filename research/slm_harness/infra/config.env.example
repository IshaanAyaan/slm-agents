# Copy to research/slm_harness/infra/config.env and edit. config.env is gitignored.
# NO SECRETS are required here. VPN/SSH credentials live OUTSIDE the repo (see RUNBOOK).

# --- Models (open weights; downloaded from HF on the box) ---
export TEACHER_MODEL="meta-llama/Llama-3.3-70B-Instruct"   # or Qwen/Qwen2.5-72B-Instruct
export STUDENT4B_MODEL="Qwen/Qwen3-4B-Instruct-2507"
export STUDENT17B_MODEL="Qwen/Qwen3-1.7B"

# --- Serving ---
export TEACHER_PORT=8001
export STUDENT_PORT=8002
export TEACHER_TP=""            # blank = auto (all visible GPUs); set e.g. 2 for 2xH100
export VLLM_API_KEY="EMPTY"     # local only; not a real secret

# --- Hardware cost (for the self-hosted cost model) ---
export GPU_HOURLY_USD=2.50      # amortized/cloud $ per H100-hour; set YOUR real rate
export NUM_GPUS=""              # blank = auto-detect via nvidia-smi

# --- Benchmark repos (real ground truth, generated on-box). Format: id:path:split ---
# Train repos feed distillation; test repos are held out for generalization.
export BENCH_REPOS="\
requests:$(python -c 'import requests,os;print(os.path.dirname(requests.__file__))'):train \
flask:$(python -c 'import flask,os;print(os.path.dirname(flask.__file__))'):train \
click:$(python -c 'import click,os;print(os.path.dirname(click.__file__))'):test"
export TRAIN_MAX_TASKS=250
export TEST_MAX_TASKS=120

# --- Experiment ---
export SEEDS=5                  # seeds per condition per task on eval
export TRAIN_SEEDS=3            # seeds for teacher data-gen on train split
export RUN_17B_ABLATION=1       # 1 = also run the 1.7B ablation
